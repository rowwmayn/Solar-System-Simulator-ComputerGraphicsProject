def init_asteroids():
    global asteroid_data
    asteroid_data = []
    for i in range(asteroid_count):
        angle = 2.0 * math.pi * (i / asteroid_count)
        distance = 1050 + 50 * math.sin(i * 7.5)
        size = 5 + 10 * (i % 3) / 3.0
        speed = 1.0 + 0.5 * (i % 5) / 5.0
        asteroid_data.append([angle, distance, size, speed])

def init_trails():
    global trail_points
    trail_points = []
    for p in range(1, len(planet_data)):
        orbit_radius = planet_data[p][1]
        trail = []
        for i in range(trail_segments):
            angle = 2.0 * math.pi * i / trail_segments
            x = orbit_radius * math.cos(angle)
            y = orbit_radius * math.sin(angle)
            trail.append((x, y))
        trail_points.append(trail)

def draw_text(x, y, text, font=GLUT_BITMAP_HELVETICA_18):
    glColor3f(1, 1, 1)
    glMatrixMode(GL_PROJECTION)
    glPushMatrix()
    glLoadIdentity()
    gluOrtho2D(0, 1000, 0, 800)
    glMatrixMode(GL_MODELVIEW)
    glPushMatrix()
    glLoadIdentity()
    glRasterPos2f(x, y)
    for ch in text:
        glutBitmapCharacter(font, ord(ch))
    glPopMatrix()
    glMatrixMode(GL_PROJECTION)
    glPopMatrix()
    glMatrixMode(GL_MODELVIEW)

def draw_trails():
    if not show_trails: return
    
    start_planet = 1
    end_planet = 4 if inner_planets_only else len(planet_data)
    
    for p in range(start_planet - 1, end_planet - 1):
        r, g, b = planet_data[p + 1][5]
        glColor3f(r * 0.5, g * 0.5, b * 0.5)
        glBegin(GL_LINE_LOOP)
        for point in trail_points[p]:
            glVertex3f(point[0], point[1], 0)
        glEnd()

def draw_sphere(radius, slices, stacks):
    gluSphere(gluNewQuadric(), radius, slices, stacks)

def draw_circle(radius, segments, r, g, b):
    """
    Draw a circle using GL_LINE_LOOP
    """
    glColor3f(r, g, b)
    glBegin(GL_LINE_LOOP)
    
    for i in range(segments):
        angle = 2.0 * math.pi * i / segments
        glVertex3f(radius * math.cos(angle), radius * math.sin(angle), 0)
    
    glEnd()

def draw_concentric_circles(inner_radius, outer_radius, num_circles, segments, base_color):
    """
    Draw multiple concentric circles to represent a disk or ring
    """
    r_base, g_base, b_base = base_color
    
    # Draw multiple circles
    for i in range(num_circles):
        t = i / (num_circles - 1)  # 0 to 1
        radius = inner_radius + t * (outer_radius - inner_radius)
        
        # Slight color variation
        if i % 3 == 0:
            r, g, b = r_base * 1.1, g_base * 1.1, b_base * 1.1
        elif i % 3 == 1:
            r, g, b = r_base, g_base, b_base
        else:
            r, g, b = r_base * 0.9, g_base * 0.9, b_base * 0.9
            
        draw_circle(radius, segments, r, g, b)

def draw_planet(planet_idx, radius, rotation_angle, axial_tilt):
    glPushMatrix()
    glRotatef(axial_tilt, 0, 1, 0)
    glRotatef(rotation_angle, 0, 0, 1)
    
    # Base planet sphere
    glColor3fv(planet_data[planet_idx][5])
    gluSphere(gluNewQuadric(), radius, 32, 32)
    
    # Add surface features based on planet type
    if planet_idx == 1:  # Mercury - add craters
        add_surface_features(radius, [(45, 20), (-30, 80), (10, 150), (60, 270)], 0.15, (0.7, 0.55, 0.55))
    
    elif planet_idx == 2:  # Venus - add cloud swirls
        add_cloud_layers(radius, 3, (1.0, 1.0, 0.8))
    
    elif planet_idx == 3:  # Earth - add continents and polar caps
        # Add polar caps
        glPushMatrix()
        glRotatef(90, 1, 0, 0)  # North pole
        glColor3f(0.9, 0.95, 1.0)
        gluDisk(gluNewQuadric(), 0, radius * 0.2, 16, 1)
        glPopMatrix()
        
        glPushMatrix()
        glRotatef(-90, 1, 0, 0)  # South pole
        glColor3f(0.9, 0.95, 1.0)
        gluDisk(gluNewQuadric(), 0, radius * 0.25, 16, 1)
        glPopMatrix()
        
        # Add continent-like features
        add_surface_features(radius, [(10, 30), (-20, 150), (40, 270)], 0.4, (0.2, 0.7, 0.2))
    
    elif planet_idx == 4:  # Mars - add dark regions and polar caps
        # Add polar cap
        glPushMatrix()
        glRotatef(90, 1, 0, 0)
        glColor3f(0.9, 0.9, 0.9)
        gluDisk(gluNewQuadric(), 0, radius * 0.15, 16, 1)
        glPopMatrix()
        
        # Dark surface features
        add_surface_features(radius, [(30, 45), (-25, 160), (15, 270)], 0.5, (0.6, 0.25, 0.2))
    
    elif planet_idx == 5:  # Jupiter - add colored bands
        # Jupiter's iconic bands
        bands = 8
        for b in range(bands):
            offset = radius * 0.02  # Slight offset for visibility
            band_radius = radius + offset - (b * offset * 2 / bands)
            # Alternate between darker and lighter bands
            if b % 2 == 0:
                glColor3f(0.95, 0.8, 0.6)
            else:
                glColor3f(0.8, 0.7, 0.5)
            
            glPushMatrix()
            # Draw a thin cylinder for each band
            glRotatef(90, 1, 0, 0)
            bottom = -radius * (0.5 - b/bands)
            top = -radius * (0.5 - (b+1)/bands)
            height = top - bottom
            gluCylinder(gluNewQuadric(), band_radius, band_radius, height, 32, 1)
            glPopMatrix()
        
        # Add the Great Red Spot
        glPushMatrix()
        glRotatef(40, 0, 1, 0)
        glTranslatef(radius*0.98, 0, 0)
        glColor3f(0.9, 0.4, 0.3)
        gluSphere(gluNewQuadric(), radius*0.2, 16, 16)
        glPopMatrix()
    
    elif planet_idx == 6:  # Saturn - add rings
        # Saturn's bands
        bands = 6
        for b in range(bands):
            offset = radius * 0.01
            band_radius = radius + offset - (b * offset * 2 / bands)
            if b % 2 == 0:
                glColor3f(0.95, 0.9, 0.7)
            else:
                glColor3f(0.85, 0.8, 0.6)
            
            glPushMatrix()
            glRotatef(90, 1, 0, 0)
            bottom = -radius * (0.5 - b/bands)
            top = -radius * (0.5 - (b+1)/bands)
            height = top - bottom
            gluCylinder(gluNewQuadric(), band_radius, band_radius, height, 32, 1)
            glPopMatrix()
        
        # Saturn's iconic rings - using concentric circles instead of gluDisk
        glPushMatrix()
        glRotatef(80, 1, 0, 0)  # Tilt the rings
        
        # Set line width for the rings
        glLineWidth(1.0)
        
        # Inner ring (darker)
        draw_concentric_circles(radius * 1.2, radius * 1.8, 20, 64, (0.8, 0.7, 0.5))
        
        # Middle ring (brighter)
        draw_concentric_circles(radius * 1.9, radius * 2.2, 15, 64, (0.9, 0.85, 0.7))
        
        # Outer ring (darker)
        draw_concentric_circles(radius * 2.3, radius * 2.5, 10, 64, (0.75, 0.7, 0.6))
        
        # Add some cross lines to create more detail
        draw_ring_crosslines(radius * 1.2, radius * 2.5, 16)
        
        glPopMatrix()
    
    elif planet_idx == 7:  # Uranus - add ring and blue-green bands
        # Uranian bands
        for b in range(4):
            band_radius = radius * (1.0 + 0.02 * (b / 4.0))
            # Subtle color variations
            if b % 2 == 0:
                glColor3f(0.5, 0.8, 0.9)
            else:
                glColor3f(0.6, 0.7, 0.8)
            
            glPushMatrix()
            glRotatef(90, 1, 0, 0)
            bottom = -radius * (0.5 - b/4)
            top = -radius * (0.5 - (b+1)/4)
            height = top - bottom
            gluCylinder(gluNewQuadric(), band_radius, band_radius, height, 32, 1)
            glPopMatrix()
        
        # Uranus' thin ring - also using circles
        glPushMatrix()
        glRotatef(98, 0, 0, 1)  # Extreme axial tilt
        glRotatef(90, 1, 0, 0)
        draw_concentric_circles(radius * 1.2, radius * 1.4, 8, 48, (0.5, 0.5, 0.6))
        glPopMatrix()
    
    elif planet_idx == 8:  # Neptune - add bands and dark spot
        # Neptunian bands (subtle)
        for b in range(5):
            band_radius = radius * (1.0 + 0.01 * (b / 5.0))
            # Subtle blue variations
            if b % 2 == 0:
                glColor3f(0.3, 0.5, 0.9)
            else:
                glColor3f(0.4, 0.6, 0.8)
            
            glPushMatrix()
            glRotatef(90, 1, 0, 0)
            bottom = -radius * (0.5 - b/5)
            top = -radius * (0.5 - (b+1)/5)
            height = top - bottom
            gluCylinder(gluNewQuadric(), band_radius, band_radius, height, 32, 1)
            glPopMatrix()
        
        # Neptune's Great Dark Spot
        glPushMatrix()
        glRotatef(20, 0, 1, 0)
        glTranslatef(radius*0.97, 0, 0)
        glColor3f(0.1, 0.2, 0.5)
        gluSphere(gluNewQuadric(), radius*0.15, 16, 16)
        glPopMatrix()
    
    glPopMatrix()

def draw_ring_crosslines(inner_radius, outer_radius, num_lines):
    """
    Draw radial lines to add more detail to rings
    """
    glColor3f(0.7, 0.65, 0.55)
    glBegin(GL_LINES)
    
    for i in range(num_lines):
        angle = 2.0 * math.pi * i / num_lines
        cos_angle = math.cos(angle)
        sin_angle = math.sin(angle)
        
        glVertex3f(inner_radius * cos_angle, inner_radius * sin_angle, 0)
        glVertex3f(outer_radius * cos_angle, outer_radius * sin_angle, 0)
    
    glEnd()

def add_surface_features(radius, positions, size_factor, color):
    """Add surface features like craters, continents, etc."""
    glColor3fv(color)
    
    for lat, lon in positions:
        glPushMatrix()
        glRotatef(lon, 0, 0, 1)    # Longitude
        glRotatef(lat, 0, 1, 0)    # Latitude
        glTranslatef(radius * 0.98, 0, 0)  # Slightly above surface
        
        # Random variation in feature size
        feature_size = radius * size_factor * (0.8 + (lat % 3) * 0.1)
        gluSphere(gluNewQuadric(), feature_size, 12, 12)
        glPopMatrix()

def add_cloud_layers(radius, layers, color):
    """Add cloud-like layers to a planet (e.g., Venus)"""
    glColor3fv(color)
    
    for i in range(layers):
        layer_radius = radius * (1.0 + 0.02 * i)
        
        # Different pattern for each layer
        offset_x = math.sin(i * 0.7) * 0.1
        offset_y = math.cos(i * 1.3) * 0.1
        
        glPushMatrix()
        glTranslatef(radius * offset_x, radius * offset_y, 0)
        gluSphere(gluNewQuadric(), layer_radius, 16, 16)
        glPopMatrix()

def draw_sun():
    glColor3fv(planet_data[0][5])
    gluSphere(gluNewQuadric(), planet_data[0][0], 30, 30)

def draw_asteroids():
    if inner_planets_only: return
    glColor3f(0.6, 0.6, 0.6)
    for asteroid in asteroid_data:
        glPushMatrix()
        glRotatef(asteroid[0] * 180/math.pi, 0, 0, 1)
        glTranslatef(asteroid[1], 0, 0)
        gluSphere(gluNewQuadric(), asteroid[2], 4, 4)
        glPopMatrix()

def draw_comet():
    if inner_planets_only: return
    r = comet_orbit_radius_min / (1 - comet_eccentricity * math.cos(comet_orbit_angle))
    x = r * math.cos(comet_orbit_angle)
    y = r * math.sin(comet_orbit_angle)
    glPushMatrix()
    glTranslatef(x, y, 0)
    glColor3f(0.8, 0.8, 1.0)
    gluSphere(gluNewQuadric(), comet_size, 10, 10)
    glPopMatrix()

def draw_rogue_asteroid():
    if not collision_mode: return
    glPushMatrix()
    glTranslatef(rogue_asteroid_position[0], rogue_asteroid_position[1], 0)
    glColor3f(0.5, 0.3, 0.3)
    gluSphere(gluNewQuadric(), rogue_asteroid_size, 10, 10)
    glPopMatrix()

def draw_planet_system(planet_idx, orbit_angle, rotation_angle):
    radius = planet_data[planet_idx][0]
    distance = planet_data[planet_idx][1]
    axial_tilt = planet_data[planet_idx][4]
    
    glPushMatrix()
    glRotatef(orbit_angle, 0, 0, 1)
    glTranslatef(distance, 0, 0)
    
    if planet_idx > 0:
        draw_planet(planet_idx, radius, rotation_angle, axial_tilt)
    
    # Selection indicator
    if selected_planet == planet_idx and not follow_mode:
        glColor3f(1, 1, 1)
        glBegin(GL_LINE_LOOP)
        for i in range(36):
            angle = math.radians(i * 10)
            x = (radius + 20) * math.cos(angle)
            y = (radius + 20) * math.sin(angle)
            glVertex3f(x, y, 0)
        glEnd()
    
    # Moons
    for i, moon in enumerate(moon_data):
        if moon[0] == planet_idx:
            glPushMatrix()
            glRotatef(moon_orbit_angles[i], 0, 0, 1)
            glTranslatef(moon[2], 0, 0)
            glColor3fv(moon[5])
            glRotatef(moon_rotation_angles[i], 0, 0, 1)
            gluSphere(gluNewQuadric(), moon[1], 10, 10)
            glPopMatrix()
    
    glPopMatrix()

def draw_solar_system():
    draw_trails()
    draw_sun()
    draw_comet()
    if not inner_planets_only:
        glColor3f(0.3,0.3,0.3)
        # Sort asteroids by their distance in descending order
        for asteroid in sorted(asteroid_data, key=lambda a: -a[1]):
            glPushMatrix()
            glRotatef(asteroid[0] * 180/math.pi, 0, 0, 1)
            glTranslatef(asteroid[1], 0, 0)
            gluSphere(gluNewQuadric(), asteroid[2], 4, 4)
            glPopMatrix()
    
    # Draw planets from outermost to innermost
    end_planet = 4 if inner_planets_only else len(planet_data)
    for i in range(end_planet - 1, 0, -1):
        draw_planet_system(i, orbit_angles[i], rotation_angles[i])
    
    # Draw rogue asteroid last (foreground element)
    draw_rogue_asteroid()

